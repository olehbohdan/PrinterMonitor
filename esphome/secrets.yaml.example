# Copy to secrets.yaml and fill in.
# secrets.yaml is loaded by ESPHome automatically.

wifi_ssid: "YourSSID"
wifi_password: "YourPassword"

# Optional: OTA + API encryption key (32 bytes base64).
# Generate with:  python3 -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
api_key: "REPLACE_WITH_BASE64_KEY"
ota_password: "REPLACE_WITH_STRONG_PASSWORD"

# Home Assistant entity IDs for your two printers.
# If you use the Moonraker integration they'll look like these:
printer_a_name: "Voron"
printer_a_state: "sensor.voron_current_print_state"
printer_a_progress: "sensor.voron_progress"
printer_a_extruder_temp: "sensor.voron_extruder_temperature"
printer_a_bed_temp: "sensor.voron_bed_temperature"
printer_a_eta: "sensor.voron_eta"

printer_b_name: "Ender"
printer_b_state: "sensor.ender_current_print_state"
printer_b_progress: "sensor.ender_progress"
printer_b_extruder_temp: "sensor.ender_extruder_temperature"
printer_b_bed_temp: "sensor.ender_bed_temperature"
printer_b_eta: "sensor.ender_eta"
